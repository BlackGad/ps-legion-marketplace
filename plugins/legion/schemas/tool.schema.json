{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "BinaryDownload": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "pathFolder": false
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "zip"
              }
            }
          },
          "then": {
            "required": [
              "pathFolder"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "resolver": {
                "const": "release-assets"
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "const": "asset-digest"
              },
              "assetName": false,
              "url": false,
              "checksumUrl": false
            },
            "required": [
              "metadataUrl",
              "assetPattern"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "resolver": {
                "const": "lts-index"
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "const": "checksum-file"
              },
              "assetPattern": false
            },
            "required": [
              "metadataUrl",
              "assetName",
              "url",
              "checksumUrl"
            ]
          }
        }
      ],
      "properties": {
        "kind": {
          "enum": [
            "msi",
            "exe",
            "zip"
          ],
          "type": "string"
        },
        "resolver": {
          "enum": [
            "release-assets",
            "lts-index"
          ],
          "type": "string"
        },
        "metadataUrl": {
          "minLength": 1,
          "type": "string"
        },
        "assetPattern": {
          "format": "regex",
          "minLength": 1,
          "type": "string"
        },
        "assetName": {
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "type": "string"
        },
        "checksumUrl": {
          "minLength": 1,
          "type": "string"
        },
        "verification": {
          "enum": [
            "asset-digest",
            "checksum-file"
          ],
          "type": "string"
        },
        "arguments": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pathFolder": {
          "pattern": "^(?![/\\\\]|[A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).*$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "resolver",
        "verification",
        "arguments"
      ],
      "type": "object"
    },
    "Foundry": {
      "additionalProperties": false,
      "properties": {
        "deploymentPrefix": {
          "minLength": 1,
          "type": "string"
        },
        "aliases": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "deploymentPrefix",
        "aliases"
      ],
      "type": "object"
    },
    "Hooks": {
      "additionalProperties": false,
      "properties": {
        "hint": {
          "type": "string"
        }
      },
      "required": [
        "hint"
      ],
      "type": "object"
    },
    "Install": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "additionalItems": {
            "type": "string"
          },
          "items": [
            {
              "minLength": 1,
              "type": "string"
            }
          ],
          "minItems": 1,
          "type": "array"
        },
        "windows": {
          "anyOf": [
            {
              "$ref": "#/$defs/Windows"
            },
            {
              "type": "null"
            }
          ]
        },
        "macos": {
          "$ref": "#/$defs/Platform"
        },
        "linux": {
          "$ref": "#/$defs/Platform"
        },
        "hint": {
          "type": "string"
        }
      },
      "required": [
        "check",
        "windows",
        "macos",
        "linux",
        "hint"
      ],
      "type": "object"
    },
    "JsonListing": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "json",
          "type": "string"
        },
        "idField": {
          "minLength": 1,
          "type": "string"
        },
        "enabledField": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "format",
        "idField",
        "enabledField"
      ],
      "type": "object"
    },
    "LinesListing": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "lines",
          "type": "string"
        },
        "rejectPattern": {
          "format": "regex",
          "type": "string"
        }
      },
      "required": [
        "format",
        "rejectPattern"
      ],
      "type": "object"
    },
    "MarketplaceListing": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "json",
          "type": "string"
        },
        "collectionField": {
          "minLength": 1,
          "type": "string"
        },
        "rootField": {
          "minLength": 1,
          "type": "string"
        },
        "nameField": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "format",
        "nameField"
      ],
      "type": "object"
    },
    "NpmInstall": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "minLength": 1,
          "type": "string"
        },
        "command": {
          "additionalItems": {
            "type": "string"
          },
          "items": [
            {
              "minLength": 1,
              "type": "string"
            }
          ],
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "check",
        "command"
      ],
      "type": "object"
    },
    "Platform": {
      "additionalProperties": false,
      "properties": {
        "needs": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "commands": {
          "items": {
            "additionalItems": {
              "type": "string"
            },
            "items": [
              {
                "minLength": 1,
                "type": "string"
              }
            ],
            "minItems": 1,
            "type": "array"
          },
          "type": "array"
        },
        "docs": {
          "type": "string"
        }
      },
      "required": [
        "needs",
        "commands",
        "docs"
      ],
      "type": "object"
    },
    "Plugin": {
      "additionalProperties": false,
      "properties": {
        "defaultConfigDir": {
          "pattern": "^(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))~/[^:]+$",
          "type": "string"
        },
        "installedRoot": {
          "pattern": "^(?![/\\\\]|[A-Za-z]:|~[/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
          "type": "string"
        },
        "adoptRewrite": {
          "items": {
            "pattern": "^(?![/\\\\]|[A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "marketplaceAdd": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "marketplaceAddRef": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "marketplaceRemove": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "install": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "uninstall": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "marketplaceUpdate": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "update": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "marketplaceListing": {
          "$ref": "#/$defs/MarketplaceListing"
        },
        "listingEnv": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "type": "object"
        },
        "marketplaceList": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "list": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "listing": {
          "oneOf": [
            {
              "$ref": "#/$defs/LinesListing"
            },
            {
              "$ref": "#/$defs/JsonListing"
            }
          ]
        }
      },
      "required": [
        "marketplaceAdd",
        "marketplaceAddRef",
        "marketplaceRemove",
        "install",
        "uninstall",
        "marketplaceUpdate",
        "update",
        "marketplaceListing",
        "marketplaceList",
        "list",
        "listing"
      ],
      "type": "object"
    },
    "ScriptDownload": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "script",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "url"
      ],
      "type": "object"
    },
    "Windows": {
      "additionalProperties": false,
      "properties": {
        "wingetId": {
          "minLength": 1,
          "type": "string"
        },
        "portableCommand": {
          "minLength": 1,
          "pattern": "^(?![/\\\\]|[A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).*$",
          "type": "string"
        },
        "npmWhenAvailable": {
          "$ref": "#/$defs/NpmInstall"
        },
        "download": {
          "$ref": "#/$defs/WindowsDownload"
        }
      },
      "required": [
        "wingetId",
        "portableCommand",
        "download"
      ],
      "type": "object"
    },
    "WindowsDownload": {
      "additionalProperties": false,
      "properties": {
        "msi": {
          "oneOf": [
            {
              "$ref": "#/$defs/ScriptDownload"
            },
            {
              "$ref": "#/$defs/BinaryDownload"
            }
          ]
        },
        "zip": {
          "oneOf": [
            {
              "$ref": "#/$defs/ScriptDownload"
            },
            {
              "$ref": "#/$defs/BinaryDownload"
            }
          ]
        }
      },
      "required": [
        "msi",
        "zip"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "command": {
      "minLength": 1,
      "type": "string"
    },
    "configEnv": {
      "pattern": "^[A-Z_][A-Z0-9_]*$",
      "type": "string"
    },
    "foundry": {
      "anyOf": [
        {
          "$ref": "#/$defs/Foundry"
        },
        {
          "type": "null"
        }
      ]
    },
    "overseerArgs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "allowRules": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "plugin": {
      "$ref": "#/$defs/Plugin"
    },
    "hooks": {
      "$ref": "#/$defs/Hooks"
    },
    "install": {
      "$ref": "#/$defs/Install"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "command",
    "configEnv",
    "foundry",
    "overseerArgs",
    "plugin",
    "hooks",
    "install"
  ],
  "type": "object",
  "title": "legion tool descriptor"
}
