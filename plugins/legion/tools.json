{
  "schemaVersion": 1,
  "wiki": {
    "marketplace": "llm-wiki",
    "pluginId": "wiki@llm-wiki",
    "source": "nvk/llm-wiki",
    "tag": "v1.0.0",
    "commit": "35d37c5591c7585643196333edd83922e7bbc757"
  },
  "tools": [
    {
      "id": "claude",
      "command": "claude",
      "configEnv": "CLAUDE_CONFIG_DIR",
      "plugin": {
        "defaultConfigDir": "~/.claude",
        "installedRoot": "plugins/cache/ps-legion-marketplace/legion",
        "marketplaceAddRef": [
          "plugin",
          "marketplace",
          "add",
          "{source}#{ref}"
        ],
        "marketplaceAdd": [
          "plugin",
          "marketplace",
          "add",
          "{source}"
        ],
        "uninstall": [
          "plugin",
          "uninstall",
          "legion@ps-legion-marketplace"
        ],
        "marketplaceRemove": [
          "plugin",
          "marketplace",
          "remove",
          "ps-legion-marketplace"
        ],
        "install": [
          "plugin",
          "install",
          "legion@ps-legion-marketplace"
        ],
        "marketplaceUpdate": [
          "plugin",
          "marketplace",
          "update",
          "ps-legion-marketplace"
        ],
        "update": [
          "plugin",
          "update",
          "legion@ps-legion-marketplace"
        ],
        "marketplaceList": [
          "plugin",
          "marketplace",
          "list",
          "--json"
        ],
        "listingEnv": {
          "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
        },
        "marketplaceListing": {
          "format": "json",
          "nameField": "name"
        },
        "list": [
          "plugin",
          "list",
          "--json"
        ],
        "listing": {
          "format": "json",
          "idField": "id",
          "enabledField": "enabled"
        }
      },
      "hooks": {
        "hint": ""
      },
      "installHint": "irm https://claude.ai/install.ps1 | iex"
    },
    {
      "id": "codex",
      "command": "codex",
      "configEnv": "CODEX_HOME",
      "plugin": {
        "defaultConfigDir": "~/.codex",
        "installedRoot": "plugins/cache/ps-legion-marketplace/legion",
        "marketplaceAddRef": [
          "plugin",
          "marketplace",
          "add",
          "{source}",
          "--ref",
          "{ref}"
        ],
        "marketplaceAdd": [
          "plugin",
          "marketplace",
          "add",
          "{source}"
        ],
        "uninstall": [
          "plugin",
          "remove",
          "legion@ps-legion-marketplace"
        ],
        "marketplaceRemove": [
          "plugin",
          "marketplace",
          "remove",
          "ps-legion-marketplace"
        ],
        "install": [
          "plugin",
          "add",
          "legion@ps-legion-marketplace"
        ],
        "marketplaceUpdate": [
          "plugin",
          "marketplace",
          "upgrade"
        ],
        "update": [
          "plugin",
          "add",
          "legion@ps-legion-marketplace"
        ],
        "marketplaceList": [
          "plugin",
          "marketplace",
          "list",
          "--json"
        ],
        "marketplaceListing": {
          "format": "json",
          "collectionField": "marketplaces",
          "nameField": "name",
          "rootField": "root"
        },
        "list": [
          "plugin",
          "list"
        ],
        "listing": {
          "format": "lines",
          "rejectPattern": "not installed|disabled"
        }
      },
      "hooks": {
        "hint": "Codex: approve the legion hooks once with /hooks in a Codex session."
      },
      "installHint": "npm install -g @openai/codex"
    },
    {
      "id": "copilot",
      "command": "copilot",
      "configEnv": "COPILOT_HOME",
      "plugin": {
        "defaultConfigDir": "~/.copilot",
        "installedRoot": "installed-plugins/ps-legion-marketplace/legion",
        "marketplaceAddRef": [
          "plugin",
          "marketplace",
          "add",
          "{source}#{ref}"
        ],
        "marketplaceAdd": [
          "plugin",
          "marketplace",
          "add",
          "{source}"
        ],
        "uninstall": [
          "plugin",
          "uninstall",
          "legion@ps-legion-marketplace"
        ],
        "marketplaceRemove": [
          "plugin",
          "marketplace",
          "remove",
          "ps-legion-marketplace",
          "--force"
        ],
        "install": [
          "plugin",
          "install",
          "legion@ps-legion-marketplace"
        ],
        "marketplaceUpdate": [
          "plugin",
          "marketplace",
          "update",
          "ps-legion-marketplace"
        ],
        "update": [
          "plugin",
          "update",
          "legion@ps-legion-marketplace"
        ],
        "marketplaceList": [
          "plugin",
          "marketplace",
          "list",
          "--json"
        ],
        "marketplaceListing": {
          "format": "json",
          "nameField": "name"
        },
        "list": [
          "plugin",
          "list"
        ],
        "listing": {
          "format": "lines",
          "rejectPattern": "not installed|disabled"
        }
      },
      "hooks": {
        "hint": ""
      },
      "installHint": "npm install -g @github/copilot"
    }
  ]
}
