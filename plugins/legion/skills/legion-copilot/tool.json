{
  "schemaVersion": 1,
  "id": "copilot", "command": "copilot", "configEnv": "COPILOT_HOME",
  "foundry": {"deploymentPrefix": "claude", "aliases": []},
  "overseerArgs": ["-i"],
  "plugin": {
    "defaultConfigDir": "~/.copilot",
    "adoptRewrite": ["config.json"],
    "installedRoot": "installed-plugins/ps-legion-marketplace/legion",
    "marketplaceAddRef": ["plugin", "marketplace", "add", "{source}#{ref}"],
    "marketplaceAdd": ["plugin", "marketplace", "add", "{source}"],
    "uninstall": ["plugin", "uninstall", "legion@ps-legion-marketplace"],
    "marketplaceRemove": ["plugin", "marketplace", "remove", "ps-legion-marketplace", "--force"],
    "install": ["plugin", "install", "legion@ps-legion-marketplace"],
    "marketplaceUpdate": ["plugin", "marketplace", "update", "ps-legion-marketplace"],
    "update": ["plugin", "update", "legion@ps-legion-marketplace"],
    "marketplaceList": ["plugin", "marketplace", "list", "--json"],
    "marketplaceListing": {"format": "json", "nameField": "name"},
    "list": ["plugin", "list"],
    "listing": {"format": "lines", "rejectPattern": "not installed|disabled"}
  },
  "hooks": {"hint": ""},
  "install": {
    "check": ["copilot", "--version"], "hint": "npm install -g @github/copilot",
    "windows": {
      "wingetId": "GitHub.Copilot", "portableCommand": "copilot.exe",
      "npmWhenAvailable": {"check": "node", "command": ["npm", "install", "-g", "@github/copilot"]},
      "download": {
        "msi": {"kind": "msi", "resolver": "release-assets", "metadataUrl": "https://api.github.com/repos/github/copilot-cli/releases/latest", "assetPattern": "^copilot-x64\\.msi$", "verification": "asset-digest", "arguments": ["/qn", "/norestart"]},
        "zip": {"kind": "zip", "resolver": "release-assets", "metadataUrl": "https://api.github.com/repos/github/copilot-cli/releases/latest", "assetPattern": "^copilot-win32-x64\\.zip$", "verification": "asset-digest", "arguments": [], "pathFolder": ""}
      }
    },
    "macos": {"needs": ["node"], "commands": [["npm", "install", "-g", "@github/copilot"]], "docs": ""},
    "linux": {"needs": ["node"], "commands": [["npm", "install", "-g", "@github/copilot"]], "docs": ""}
  }
}
